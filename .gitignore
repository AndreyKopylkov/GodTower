# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
crashlytics-buildid.txt
sysinfo.txt

# Asset Store packages (Standard Unity Asset Store EULA forbids public redistribution of source files).
# Import them from the Asset Store — see README "Third-party assets".
/[Aa]ssets/JMO Assets/
/[Aa]ssets/JMO Assets.meta
/[Aa]ssets/Hovl Studio/
/[Aa]ssets/Hovl Studio.meta

# Private reference material from the brief
/Reference/

# Local tooling
.claude/
.DS_Store
Thumbs.db

# Test output
/TestResults/

# Frames extracted from the private reference video
/Art/Source/**/RefFrames/
__pycache__/
*.pyc
